<link rel="preconnect" href="https://unpkg.com" crossorigin>
<link href="https://unpkg.com/@fortawesome/fontawesome-free@^6/css/all.min.css" rel="stylesheet">
{# Union Examples #}
<div class="flx --flxColumn --gap-50 --pY-50">
  <section>
    <h2>Union Examples</h2>
    <div class="flx --flxColumn --gap-30">
      <!-- Basic Union (Shorthand Flex Alignment) -->
      <div>
        <h3>Basic Union (Shorthand Flex Alignment)</h3>
        <div class="flx --flxRow --gap-10" style="height: 100px; background: #eee;">
          <div class="--p-10 --bgColor-secondary1 --txtColor-secondary --bdr --bdrColor-secondary1 --flx-center">--flx-center (shorthand center-center)</div>
          <div class="--p-10 --bgColor-success1 --txtColor-success --bdr --bdrColor-success1 --flx-between-stretch --width-full">--flx-between-stretch</div>
        </div>
      </div>

      <!-- Item Self Alignment Unions -->
      <div>
        <h3>Item Self Alignment Unions</h3>
        <div class="flx --flxRow --gap-10" style="height: 120px; background: #eee;">
          <div class="--p-10 --bgColor-secondary1 --txtColor-secondary --bdr --bdrColor-secondary1 --flxSelf-end">--flxSelf-end (aligns self to bottom-center)</div>
          <div class="--p-10 --bgColor-success1 --txtColor-success --bdr --bdrColor-success1 --flxSelf-stretch">--flxSelf-stretch</div>
        </div>
      </div>

      <!-- Flexbox Growth Unions -->
      <div>
        <h3>Flexbox Growth Unions</h3>
        <div class="flx --flxRow --gap-10">
          <div class="--p-10 --bgColor-secondary1 --txtColor-secondary --bdr --bdrColor-secondary1 --flx">--flx (flex: 1 1 auto)</div>
          <div class="--p-10 --bgColor-success1 --txtColor-success --bdr --bdrColor-success1 --flx-fit">--flx-fit (flex: 1 0 auto)</div>
          <div class="--p-10 --bgColor-secondary1 --txtColor-secondary --bdr --bdrColor-secondary1 --flx-fill">--flx-fill (flex: 1 1 100%)</div>
        </div>
      </div>

      <!-- Responsive Union Layout -->
      <div>
        <h3>Responsive Union Layout</h3>
        <div class="flx --flxColumn:sm --flxRow:md --gap-10">
          <div class="--p-10 --bgColor-secondary1 --txtColor-secondary --bdr --bdrColor-secondary1 --width-100 --width-50:md">--width-100 --width-50:md</div>
          <div class="--p-10 --bgColor-success1 --txtColor-success --bdr --bdrColor-success1 --width-100 --width-50:md">--width-100 --width-50:md</div>
        </div>
      </div>
    </div>
  </section>
</div>
