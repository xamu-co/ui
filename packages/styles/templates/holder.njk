<link rel="preconnect" href="https://unpkg.com" crossorigin>
<link href="https://unpkg.com/@fortawesome/fontawesome-free@^6/css/all.min.css" rel="stylesheet">
{# Holder Example #}
<div class="flx --flxColumn --gap-50 --pY-50">
  <section>
    <h2>Holder Layout</h2>
    <p>Limits content max-width to 75rem (1200px) and centers it horizontally with transition padding.</p>
    
    <div class="holder --bgColor-primary1 --pY-30" style="border: 2px dashed #0f47af;">
      <div class="--p-20 --bgColor-primary --txtColor-light">
        <h3>This content is wrapped inside a <code>.holder</code></h3>
        <p>Resize the viewport to see padding adjust between mobile (1rem) and tablet/desktop (2rem).</p>
      </div>
    </div>
  </section>
</div>
