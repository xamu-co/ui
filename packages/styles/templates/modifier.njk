<link rel="preconnect" href="https://unpkg.com" crossorigin>
<link href="https://unpkg.com/@fortawesome/fontawesome-free@^6/css/all.min.css" rel="stylesheet">
{# Modifier Examples #}
<div class="flx --flxColumn --gap-50 --pY-50">
  <section>
    <h2>Modifier Examples</h2>
    <div class="flx --flxColumn --gap-30">
      <!-- Basic Modifier -->
      <div>
        <h3>Basic Modifier</h3>
        <div class="flx --flxRow --gap-10">
          <div class="--p-10 --bgColor-secondary1 --txtColor-secondary --bdr --bdrColor-secondary1">Default</div>
          <div class="--p-10 --bgColor-secondary1 --txtColor-secondary --bdr --bdrColor-secondary1 --opacity-05">With --opacity-05</div>
        </div>
      </div>
      <div>
        <h3>Color Modifier Shades</h3>
        <div class="flx --flxRow --gap-10">
          <div class="--p-10 --bgColor-dark1 --txtColor-light">--bgColor-dark1 (10% Opacity)</div>
          <div class="--p-10 --bgColor-dark5 --txtColor-light">--bgColor-dark5 (50% Opacity)</div>
          <div class="--p-10 --bgColor-dark9 --txtColor-light">--bgColor-dark9 (90% Opacity)</div>
        </div>
      </div>
      <div>
        <h3>Responsive Visibility Modifiers</h3>
        <div class="flx --flxColumn --gap-10">
          <div class="--p-10 --bgColor-secondary1 --txtColor-secondary --bdr --bdrColor-secondary1 --hidden-full:md">Hidden on medium screens and up (--hidden-full:md)</div>
          <div class="--p-10 --bgColor-success1 --txtColor-success --bdr --bdrColor-success1 --hidden-full:md-inv">Visible only on medium screens and up (--hidden-full and --display-block:md)</div>
        </div>
      </div>
    </div>
  </section>
</div>
