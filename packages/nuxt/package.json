{
  "name": "@open-xamu-co/ui-nuxt",
  "version": "0.0.1",
  "description": "Nuxt 3 module for the xamu project",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xamu-co/ui.git"
  },
  "keywords": [
    "vue",
    "component",
    "system"
  ],
  "author": "@xamu-co",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xamu-co/ui/issues"
  },
  "homepage": "https://github.com/xamu-co/ui/packages/vue#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.2",
    "yarn": ">=1.22.22"
  },
  "scripts": {
    "build": "yarn build:prepack && nuxt-module-build build",
    "build:prepack": "nuxt-module-build build && nuxt prepare playground",
    "dev": "yarn dev:prepare && nuxt dev playground",
    "dev:build": "yarn countries && nuxt build playground && node scripts/postbuild.cjs",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare layground",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.6.3",
    "@open-xamu-co/ui-common-enums": "link:../common-enums",
    "@open-xamu-co/ui-common-helpers": "link:../common-helpers",
    "@open-xamu-co/ui-components-vue": "link:../components-vue",
    "lodash-es": "^4.17.21",
    "sweetalert2": "^11.11.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.3",
    "@nuxt/test-utils": "^4.3.3",
    "@open-xamu-co/ui-common-types": "link:../common-types",
    "@open-xamu-co/ui-styles": "link:../styles",
    "@types/lodash-es": "^4.14.192",
    "nuxt": "^4.6.3"
  }
}